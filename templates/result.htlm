<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analysis Results</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <script src="{{ url_for('static', filename='js/script.js') }}" defer></script>
</head>
<body>
    <div class="container">
        <div class="title fade">Analysis Output Summary</div>
        <div class="subtitle fade">NeuroVision diagnostic identification details</div>

        <div class="card fade">
            <h2>Classification Result: <span style="color: #00c8ff;">{{ prediction }}</span></h2>
            <h3>System Confidence: <span style="color: #00c8ff;">{{ confidence }}%</span></h3>
        </div>

        <div class="card fade" style="display: flex; justify-content: space-around; flex-wrap: wrap; gap: 20px;">
            <div style="flex: 1; min-width: 250px;">
                <h4>Submitted MRI Image</h4>
                <img src="{{ url_for('static', filename=image) }}" alt="Source Scan File" style="max-width: 100%; height: auto; max-height: 300px; border: 2px solid rgba(255,255,255,0.2);">
            </div>
            <div style="flex: 1; min-width: 250px;">
                <h4>Grad-CAM Target Heatmap</h4>
                <img src="{{ url_for('static', filename=heatmap_image) }}" alt="AI Visual Localization Map" style="max-width: 100%; height: auto; max-height: 300px; border: 2px solid #00c8ff;">
            </div>
        </div>

        <br>
        <a href="/"><button type="button">Process Another Scan</button></a>
    </div>
</body>
</html>
